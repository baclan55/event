# ============================================================================
# Скопируйте этот файл в .env и заполните значения.
# .env НЕ должен попадать в git (он уже в .gitignore).
# ============================================================================

# --- База данных -------------------------------------------------------
# Для Neon: Dashboard -> ваш проект -> Connect -> "Connection string" (psql).
# Обязательно оставьте ?sslmode=require в конце строки.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Сессии --------------------------------------------------------------
# Любая длинная случайная строка. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# --- Учётная запись владельца, создаётся автоматически при первом запуске
# npm run db:seed (если пользователь с таким логином ещё не существует)
OWNER_LOGIN=owner
OWNER_PASSWORD=change-this-password
OWNER_NICKNAME=Владелец

# --- Внешний вид/название портала (необязательно) -----------------------
APP_TITLE=Event Department
APP_SUBTITLE=Внутренний портал
# Порог мероприятий в неделю, ниже которого счётчик горит красным
WEEKLY_EVENTS_TARGET=5

# --- Вход через Discord (необязательно) ----------------------------------
# Создайте приложение на https://discord.com/developers/applications
# Redirect URI должен быть: <ваш домен>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# --- Прочее ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
