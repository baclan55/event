# =============================================================================
# Канонический список переменных для Portainer / .env
# Имена должны совпадать один в один. Значения подставляются при деплое
# (Portainer Stack → Environment) или из файла .env рядом с compose.
# =============================================================================

# --- обязательные ---
DATABASE_URL=postgresql://eventportal:eventportal@db:5432/eventportal
SESSION_SECRET=замените-на-случайную-строку-не-короче-32-символов
DISCORD_OWNER_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://event.mjdn.ru/api/auth/discord/callback
DISCORD_BOT_TOKEN=
APP_DOMAIN=event.mjdn.ru
DISCORD_RELAY_URL=https://hidden-union-525e.majes.workers.dev
DISCORD_RELAY_SECRET=

# --- желательные (есть дефолты в коде) ---
APP_TITLE=Events Denver
APP_SUBTITLE=Ивент-отдел сервера
WEEKLY_EVENTS_TARGET=5

# --- опциональные ---
APPLICATIONS_WEBHOOK_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
