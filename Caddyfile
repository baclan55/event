{
	# Let's Encrypt шлёт уведомления об истечении сертификата сюда.
	email {$ACME_EMAIL:admin@event.mjdn.ru}
}

https://{$APP_DOMAIN:event.mjdn.ru} {
	encode gzip
	reverse_proxy app:3000 {
		# Всегда https для Express (secure-cookie, редиректы после Discord).
		# Нельзя писать {scheme}: при Cloudflare Flexible / TLS до Caddy
		# схема до reverse_proxy может быть http, и тогда колбэк/редирект
		# после логина уезжают на http:// несмотря на https в DISCORD_REDIRECT_URI.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}

http://{$APP_DOMAIN:event.mjdn.ru} {
	redir https://{$APP_DOMAIN:event.mjdn.ru}{uri} permanent
}

# Прямой заход по IP или с чужим Host — без сайта.
:80, :443 {
	respond "Not Found" 404
}
