{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	servers {
		# Только HTTP/1.1 — иначе Cloudflare даёт ERR_HTTP2_PROTOCOL_ERROR на JS.
		protocols h1
	}
}

(static_files) {
	# Cloudflare периодически обрывает несжатый origin-response после первых
	# 3–4 КБ. Сжатие выполняется Caddy до отправки в CF и удерживает HTML/CSS/JS
	# в одном небольшом ответе; соединение с origin остаётся HTTP/1.1.
	encode gzip

	@nextstatic path /_next/static*
	handle @nextstatic {
		root * /srv
		header Cache-Control "no-store"
		header CDN-Cache-Control "no-store"
		header Cloudflare-CDN-Cache-Control "no-store"
		file_server
	}

	@css path /css*
	handle @css {
		root * /srv/public
		header Cache-Control "no-store"
		header CDN-Cache-Control "no-store"
		file_server
	}

	@img path /img*
	handle @img {
		root * /srv/public
		header Cache-Control "no-store"
		header CDN-Cache-Control "no-store"
		file_server
	}
}

https://{$APP_DOMAIN} {
	import static_files

	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				versions 1.1
				dial_timeout 5s
				response_header_timeout 60s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
}

http://{$APP_DOMAIN} {
	import static_files

	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			transport http {
				versions 1.1
				dial_timeout 5s
				response_header_timeout 60s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
}

:80, :443 {
	respond "Not Found" 404
}
