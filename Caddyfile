{
	# Let's Encrypt шлёт уведомления об истечении сертификата сюда.
	email {$ACME_EMAIL:admin@event.mjdn.ru}
}

{$APP_DOMAIN:event.mjdn.ru} {
	encode gzip
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Прямой заход по IP или с чужим Host — без сайта (только домен выше).
:80, :443 {
	respond "Not Found" 404
}
