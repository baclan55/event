{
  "name": "event-department-portal",
  "version": "1.0.0",
  "description": "Внутренний портал Event-отдела: FAQ, состав, правила, регламент, заявки и выговоры. Express + PostgreSQL (Docker).",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "bot": "node src/bot/standalone.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "event-bot:backfill": "node src/bot/backfillEventCredits.js",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "connect-pg-simple": "^9.0.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "markdown-it": "^15.0.0",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "sanitize-html": "^2.17.6"
  }
}
